# Database
DATABASE_URL=postgresql://cryptoagent:cryptoagent_dev@localhost:5434/cryptoagent
POSTGRES_USER=cryptoagent
POSTGRES_PASSWORD=cryptoagent_dev
POSTGRES_DB=cryptoagent

# Exchange
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Paper trading
INITIAL_CAPITAL=100000
MAX_POSITION_PCT=0.20

# Strategy
DEFAULT_STRATEGY=sma_crossover
SMA_FAST_PERIOD=10
SMA_SLOW_PERIOD=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Data
CANDLE_TIMEFRAME=1m
CANDLE_HISTORY_DAYS=7
POLL_INTERVAL_SECONDS=10

# Logging
LOG_LEVEL=INFO
